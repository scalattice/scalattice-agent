 #include <cstring>
 #include <string>
 
+// --stream is not a llama.cpp flag. Strip it before common_params_parse.
+// While it is set, each finished audio window is written to stdout (WAV header,
+// then PCM) so a caller can play the clip before the last frame.
+static bool take_stream_flag(int & argc, char ** argv) {
+    bool stream = false;
+    int kept = 0;
+    for (int i = 0; i < argc; ++i) {
+        if (std::strcmp(argv[i], "--stream") == 0) {
+            stream = true;
+            continue;
+        }
+        argv[kept++] = argv[i];
+    }
+    argc = kept;
+    return stream;
+}
+
+static bool write_stream_chunk(mtmd_helper::gen_audio & gen) {
+    int32_t sample_rate = 0;
+    const char * data = nullptr;
+    size_t data_len = 0;
+    if (gen.get_output(&sample_rate, &data, &data_len, nullptr) != 0) {
+        LOG_ERR("get_output failed\n");
+        return false;
+    }
+    if (data_len == 0 || data == nullptr) {
+        return true;
+    }
+    if (std::fwrite(data, 1, data_len, stdout) != data_len) {
+        LOG_ERR("failed to write audio chunk\n");
+        return false;
+    }
+    std::fflush(stdout);
+    return true;
+}
+
