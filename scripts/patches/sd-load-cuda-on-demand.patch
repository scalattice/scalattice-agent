--- a/src/core/ggml_extend_backend.cpp
+++ b/src/core/ggml_extend_backend.cpp
@@ -11,7 +11,60 @@
 #include <vector>
 
 #ifdef SD_USE_CUDA
-#include <cuda.h>
+#if defined(_WIN32)
+#include <windows.h>
+#else
+#include <dlfcn.h>
+#endif
+
+// Driver API types, kept local so this file does not need the CUDA toolkit
+// headers. The values match cuda.h.
+using CUresult = int;
+using CUdevice = int;
+using CUdevice_attribute = int;
+constexpr CUresult CUDA_SUCCESS = 0;
+constexpr CUdevice_attribute CU_DEVICE_ATTRIBUTE_COMPUTE_CAPABILITY_MAJOR = 75;
+constexpr CUdevice_attribute CU_DEVICE_ATTRIBUTE_COMPUTE_CAPABILITY_MINOR = 76;
+
+struct SdCudaDriver {
+    CUresult (*init)(unsigned int);
+    CUresult (*device_get)(CUdevice*, const char*);
+    CUresult (*device_attr)(int*, CUdevice_attribute, CUdevice);
+};
+
+// The driver is opened only while measuring an NVIDIA device. The image
+// runner itself does not list libcuda as a library it needs at startup.
+static const SdCudaDriver* sd_cuda_driver() {
+    static SdCudaDriver api{};
+    static int state = 0;
+    if (state == 0) {
+        state = -1;
+#if defined(_WIN32)
+        HMODULE lib = LoadLibraryA("nvcuda.dll");
+        if (lib == nullptr) {
+            return nullptr;
+        }
+        api.init       = reinterpret_cast<CUresult (*)(unsigned int)>(GetProcAddress(lib, "cuInit"));
+        api.device_get = reinterpret_cast<CUresult (*)(CUdevice*, const char*)>(GetProcAddress(lib, "cuDeviceGetByPCIBusId"));
+        api.device_attr =
+            reinterpret_cast<CUresult (*)(int*, CUdevice_attribute, CUdevice)>(GetProcAddress(lib, "cuDeviceGetAttribute"));
+#else
+        void* lib = dlopen("libcuda.so.1", RTLD_LAZY | RTLD_LOCAL);
+        if (lib == nullptr) {
+            return nullptr;
+        }
+        api.init       = reinterpret_cast<CUresult (*)(unsigned int)>(dlsym(lib, "cuInit"));
+        api.device_get = reinterpret_cast<CUresult (*)(CUdevice*, const char*)>(dlsym(lib, "cuDeviceGetByPCIBusId"));
+        api.device_attr =
+            reinterpret_cast<CUresult (*)(int*, CUdevice_attribute, CUdevice)>(dlsym(lib, "cuDeviceGetAttribute"));
+#endif
+        if (api.init == nullptr || api.device_get == nullptr || api.device_attr == nullptr) {
+            return nullptr;
+        }
+        state = 1;
+    }
+    return state == 1 ? &api : nullptr;
+}
 #endif
 
