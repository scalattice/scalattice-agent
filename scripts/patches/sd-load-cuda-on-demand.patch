@@ -0,0 +1,7 @@
+#include "core/cuda/registration.h"
+
+// Loaded with dlopen only after the process has started. AMD and Intel machines
+// never open this file, so a missing libcuda does not stop the runner.
+extern "C" void sd_cuda_register_extensions(ggml_backend_dev_t device) {
+    sd_cuda::register_extensions(device);
+}
