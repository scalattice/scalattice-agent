+static void sd_register_cuda_plugin(ggml_backend_dev_t device) {
+    const char* name = ggml_backend_dev_name(device);
+    if (name == nullptr || std::strstr(name, "CUDA") == nullptr) {
+        return;
+    }
+    using RegisterFn = void (*)(ggml_backend_dev_t);
+    static RegisterFn reg = nullptr;
+    static bool tried     = false;
+    if (!tried) {
+        tried = true;
+#if defined(_WIN32)
+        HMODULE lib = LoadLibraryA("sd-cuda.dll");
+        if (lib != nullptr) {
+            reg = reinterpret_cast<RegisterFn>(GetProcAddress(lib, "sd_cuda_register_extensions"));
+        }
+#else
+        void* lib = dlopen("libsd-cuda.so", RTLD_NOW | RTLD_LOCAL);
+        if (lib != nullptr) {
+            reg = reinterpret_cast<RegisterFn>(dlsym(lib, "sd_cuda_register_extensions"));
+        }
+#endif
+    }
+    if (reg != nullptr) {
+        reg(device);
+    }
+}
